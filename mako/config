font=JetBrainsMonoNL Nerd Font:weight=bold:size=11
width=340
height=120
margin=10
padding=12
border-size=2
border-radius=0
text-alignment=left

layer=overlay
anchor=top-right

markup=1
actions=1
history=1
icons=1
max-icon-size=32
icon-location=left

ignore-timeout=0
default-timeout=5000
max-history=50
max-visible=4
sort=-time

on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

background-color=#000000e6
text-color=#4aaa6a
border-color=#1a2a1a
progress-color=over #2ae88a

[urgency=low]
border-color=#1a2a1a
default-timeout=2000

[urgency=normal]
border-color=#1a2a1a
default-timeout=5000

[urgency=high]
border-color=#2ae88a
text-color=#6affaa
default-timeout=0
